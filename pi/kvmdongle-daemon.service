[Unit]
Description=KVM dongle: serial control daemon (HID + mass storage bridge)
Requires=kvmdongle-gadget.service
After=kvmdongle-gadget.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/kvmdongle/daemon.py
Restart=on-failure
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
